type Priority = "low" | "normal" | "high" | "urgent";
type Identifier = string & { readonly __brand: unique symbol };

interface Coordinates {
  latitude: number;
  longitude: number;
}

interface Task {
  id: Identifier;
  title: string;
  description: string;
  priority: Priority;
  completed: boolean;
  tags: string[];
  location?: Coordinates;
  createdAt: Date;
  updatedAt: Date;
}

interface TaskFilter {
  query?: string;
  priorities?: Priority[];
  completed?: boolean;
  tags?: string[];
  createdAfter?: Date;
}

const DEFAULT_PRIORITIES: readonly Priority[] = [
  "low",
  "normal",
  "high",
  "urgent",
];

const SAMPLE_TITLES = [
