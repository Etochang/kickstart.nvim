}

function assert(condition: unknown, message: string): asserts condition {
  if (!condition) {
    throw new Error(`Assertion failed: ${message}`);
  }
}

function runRepositoryChecks(): void {
  const repository = new TaskRepository();
  const events = new EventBus<ApplicationEvents>();
  const service = new TaskService(repository, events);
  const observed: string[] = [];

  const unsubscribeCreated = events.subscribe("task:created", (task) => {
    observed.push(`created:${task.id}`);
  });

  const unsubscribeUpdated = events.subscribe("task:updated", (task) => {
    observed.push(`updated:${task.id}`);
  });

  const task = service.create({
    title: "Verify repository behavior",
    priority: "high",
    tags: ["test", "repository", "test"],
  });

  assert(repository.revision === 1, "adding a task increments the revision");
  assert(task.tags.length === 2, "duplicate tags are removed");
  assert(repository.search({ priorities: ["high"] }).length === 1, "priority search works");

  service.complete(task.id);
  assert(repository.find(task.id)?.completed === true, "completion is persisted");
  assert(observed.length === 2, "creation and update events are published");

  unsubscribeCreated();
  unsubscribeUpdated();
  service.discard(task.id);
  assert(repository.search().length === 0, "discarded tasks disappear");
}

async function simulateRemoteSync(tasks: readonly Task[]): Promise<number> {
  let uploaded = 0;

  for (const task of tasks) {
    await retry(
      async () => {
        const response = { ok: true, status: 202, taskId: task.id };

        if (!response.ok) {
          throw new Error(`Upload failed with status ${response.status}`);
        }

        uploaded += 1;
      },
      { attempts: 3, initialDelayMs: 10 },
    );
  }

  return uploaded;
}

async function main(): Promise<void> {
  runRepositoryChecks();

  const repository = new TaskRepository();
  const events = new EventBus<ApplicationEvents>();
  const service = new TaskService(repository, events);
  const eventLog: string[] = [];

  events.subscribe("task:created", ({ id, title }) => {
    eventLog.push(`Created ${id}: ${title}`);
  });

  events.subscribe("task:updated", ({ id, completed }) => {
    eventLog.push(`Updated ${id}; completed=${completed}`);
  });

  events.subscribe("sync:finished", ({ count, elapsedMs }) => {
    eventLog.push(`Synchronized ${count} tasks in ${elapsedMs.toFixed(2)} ms`);
  });

  const tasks = createSampleTasks(service);
  service.complete(tasks[1].id);
  service.complete(tasks[4].id);
  service.postpone(tasks[3].id, "Waiting for benchmark data from the staging environment.");

  const startedAt = performance.now();
  const synchronized = await simulateRemoteSync(repository.search());
  const elapsedMs = performance.now() - startedAt;
  events.publish("sync:finished", { count: synchronized, elapsedMs });

  console.log(renderReport(repository.search()));
  console.log("\nEVENT LOG\n" + "=".repeat(72));

  for (const [index, entry] of eventLog.entries()) {
    console.log(`${String(index + 1).padStart(2, "0")}. ${entry}`);
  }
}

main().catch((error: unknown) => {
  const message = error instanceof Error ? error.stack ?? error.message : String(error);
  console.error("Fatal application error:\n", message);
  process.exitCode = 1;
});

