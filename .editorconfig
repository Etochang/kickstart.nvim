root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Lua convention in this repository matches StyLua's two-space configuration.
[*.lua]
indent_style = space
indent_size = 2

# Embedded projects can override this policy with their own .editorconfig.
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
tab_width = 4
